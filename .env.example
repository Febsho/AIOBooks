NODE_ENV=development
LOG_LEVEL=info
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://aiobooks:change-me@postgres:5432/aiobooks
REDIS_URL=redis://redis:6379
ACQUISITION_STAGING_PATH=/data/staging
LIBRARY_ROOT_PATH=/data/libraries
SESSION_TTL_DAYS=30
# Used once when the database has no users. Remove the password after first boot.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=
# Identify the instance responsibly to metadata providers.
OPENLIBRARY_USER_AGENT=AIOBooks/dev (admin@example.invalid)
